# Copy to .env.local. Never commit .env.local.
# MongoDB: paste the connection string from MongoDB Compass.
MONGODB_URI=mongodb://127.0.0.1:27017/cohort_monitor
# Optional. Leave out to use the database name in the URI.
MONGODB_DB=cohort_monitor
API_TOKEN=change-me-long-random-string

# Microsoft sign-in (Azure app registration, single tenant)
AUTH_SECRET=generate-with-openssl-rand-base64-33
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=
ALLOWED_EMAIL_DOMAIN=codebasics.io
# Self-hosted production (next start): Auth.js refuses requests unless it trusts
# the host. Set the public site URL, or set AUTH_TRUST_HOST=true behind a proxy
# that sets the Host header. Not needed in local dev.
# AUTH_URL=https://planner.example.com
# AUTH_TRUST_HOST=true
# Entra: enable the optional "email" claim, or sign-in uses preferred_username.
# OWNER_EMAIL must equal the owner's Microsoft sign-in name (UPN).
# This account is always the owner. The owner role is never shown to others.
OWNER_EMAIL=you@codebasics.io
